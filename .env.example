# ---------------------------------------------------------------------------
# Skoon Carbon Lab — website environment configuration
# Copy to `.env.local` and fill in. NEVER commit real values.
# ---------------------------------------------------------------------------

# Public site origin, used for canonical URLs, sitemap and Open Graph tags.
# Example: https://www.skooncarbonlab.com
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ---------------------------------------------------------------------------
# ENQUIRY FORM DELIVERY
# ---------------------------------------------------------------------------
# The contact form posts to /api/enquiry. Delivery is OPTIONAL and DISABLED by
# default. No destination address is invented anywhere in this project.
#
# While ENQUIRY_TO_EMAIL is unset the form still works end-to-end and returns an
# explicit "not configured" outcome — it never silently discards an enquiry and
# never claims to have sent mail it did not send.
#
# To enable delivery you must supply a verified destination AND credentials.
# Two transports are supported.
#
# --- Option A: Resend (https://resend.com) ---
# ENQUIRY_TRANSPORT=resend
# ENQUIRY_TO_EMAIL=            # verified recipient address (required)
# ENQUIRY_FROM_EMAIL=          # verified sender on your domain (required)
# RESEND_API_KEY=              # server-side only, never exposed to the client
#
# --- Option B: Generic webhook (Zapier / Make / Slack / your own endpoint) ---
# ENQUIRY_TRANSPORT=webhook
# ENQUIRY_WEBHOOK_URL=         # https endpoint that accepts a JSON POST
#
# Leave everything below unset to run in "not configured" mode.
ENQUIRY_TRANSPORT=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
RESEND_API_KEY=
ENQUIRY_WEBHOOK_URL=
